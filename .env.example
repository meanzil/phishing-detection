# Create an API key from your Ollama account settings.
# Never commit your real .env file or paste your key into source code.
OLLAMA_API_KEY=replace_with_your_ollama_cloud_api_key

# Ollama Cloud OpenAI-compatible API
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b

# Local Streamable HTTP MCP server used by the dashboard
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
